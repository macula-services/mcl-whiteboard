#!/bin/sh
# Erlang distribution: long name on loopback only, and a cookie the BOX
# supplies. A mix release otherwise ships the random cookie it generated at
# build time, which makes it the same for every container of this image, and
# the image is public. With host networking, loopback-only distribution plus a
# per-box cookie is what keeps `bin/mcl_whiteboard remote` to the box's own
# operator.
export RELEASE_DISTRIBUTION=name
export RELEASE_NODE="${RELEASE_NODE:-mcl_whiteboard@127.0.0.1}"
export ERL_EPMD_ADDRESS=127.0.0.1

if [ -z "${RELEASE_COOKIE:-}" ]; then
  echo "mcl-whiteboard: RELEASE_COOKIE is not set; give this box its own cookie (see deploy/docker-compose.yml)" >&2
  exit 1
fi
